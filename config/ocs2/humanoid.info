; OCS2 Wheel Humanoid Configuration
; ==================================

;=============================================================================
; Model Information
;=============================================================================

model_information
{
    manipulatorModelType    1

    ; Frame definitions (aligned with MobileManipulatorInterface)
    baseFrame               "base_footprint"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"
    bodyFrame               "body_link4"

    ; Joints to remove (fixed joints, mimic joints detected automatically)
    removeJoints
    {
        [0]  "head_joint1"
        [1]  "head_joint2"
        [2]  "rr_steer_joint"
        [3]  "rr_wheel_joint"
        [4]  "rl_steer_joint"
        [5]  "rl_wheel_joint"
        [6]  "fr_steer_joint"
        [7]  "fr_wheel_joint"
        [8]  "fl_steer_joint"
        [9]  "fl_wheel_joint"
        [10]  "left_gripper_joint"
        [11]  "right_gripper_joint"
    }
}

;=============================================================================
; Model Settings
;=============================================================================

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

;=============================================================================
; Initial State
;=============================================================================

initialState
{

    base
    {
        wheelBasedMobileManipulator
        {
            (0,0) 0.0   ; x
            (1,0) 0.0   ; y
            (2,0) 0.0   ; yaw
        }
    }

    arm
    {
        (0,0)   -0.899      ; body_joint1
        (1,0)   -1.714      ; body_joint2
        (2,0)   -0.865      ; body_joint3
        (3,0)   0.0         ; body_joint4
        (4,0)   1.457133809892805      ; left_joint1
        (5,0)   -1.0633699963902674    ; left_joint2
        (6,0)   -1.1994065285584414    ; left_joint3
        (7,0)   -0.8074199090303408    ; left_joint4
        (8,0)   -0.6949558811978124    ; left_joint5
        (9,0)   -0.6864381599253574    ; left_joint6
        (10,0)  -0.1295225067208675    ; left_joint7
        (11,0)  -1.457133809892805     ; right_joint1
        (12,0)  -1.0633699963902674    ; right_joint2
        (13,0)  1.1994065285584414     ; right_joint3
        (14,0)  -0.8074199090303408    ; right_joint4
        (15,0)  0.6949558811978124     ; right_joint5
        (16,0)  -0.6864381599253574    ; right_joint6
        (17,0)  0.1295225067208675     ; right_joint7
    }
}

;=============================================================================
; Initial Mode Schedule
;=============================================================================

initialModeSchedule
{
    ; No switching events initially
    eventTimes
    {
    }
    
    ; Start in HM_DUAL_RELATIVE_MOBILE_BASE (dual arms, body RELATIVE, base mobile)
    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_RELATIVE_MOBILE_BASE"
            headMode "HEAD_DISABLE"
        }
    }
}

;=============================================================================
; DDP Settings
;=============================================================================

ddp
{
    algorithm                       SLQ

    nThreads                        4
    threadPriority                  50

    maxNumIterations                10
    minRelCost                      1e-3
    constraintTolerance             5e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            10000
    timeStep                        0.01
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               true

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-5
    }
}

;=============================================================================
; MPC Settings
;=============================================================================

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              -1
    coldStart                       false

    debugPrint                      false

    mpcDesiredFrequency             100
    mrtDesiredFrequency             400
}

;=============================================================================
; Rollout Settings
;=============================================================================

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        0.01
    integratorType                  ODE45
    maxNumStepsPerSecond            10000
    checkNumericalStability         false
}

;=============================================================================
; Input Cost
;=============================================================================

inputCost
{
    R
    {
        ; Base input cost (2 DOF for WheelBasedMobileManipulator: v_linear, omega)
        base
        {
            wheelBasedMobileManipulator
            {
                scaling 1e-2

                (0,0)   1.0     ; linear velocity
                (1,1)   1.0     ; angular velocity (yaw rate)
            }
        }

        ; Arm joint velocity costs
        arm
        {
            scaling 1e-3

             (0,0)   1.0       ; body_joint1
             (1,0)   1.0       ; body_joint2
             (2,0)   1.0       ; body_joint3
             (3,0)   1.0       ; body_joint4
             (4,0)   1.0      ; left_joint1
             (5,0)   1.0      ; left_joint2
             (6,0)   1.0      ; left_joint3
             (7,0)   1.0      ; left_joint4
             (8,0)   1.0      ; left_joint5
             (9,0)   1.0      ; left_joint6
             (10,0)  1.0      ; left_joint7
             (11,0)  1.0      ; right_joint1
             (12,0)  1.0      ; right_joint2
             (13,0)  1.0      ; right_joint3
             (14,0)  1.0      ; right_joint4
             (15,0)  1.0      ; right_joint5
             (16,0)  1.0      ; right_joint6
             (17,0)  1.0      ; right_joint7
        }
    }
}

;=============================================================================
; End Effector Constraint
;=============================================================================

endEffector
{
    dualArmMode      true
    leftArm
    {
        muPosition      10.0
        muOrientation    5.0
    }
    rightArm
    {
        muPosition      10.0
        muOrientation    5.0
    }
}

finalEndEffector
{
    dualArmMode      true
    leftArm
    {
        muPosition      10.0
        muOrientation    5.0
    }
    rightArm
    {
        muPosition      10.0
        muOrientation    5.0
    }
}

;=============================================================================
; Body Relative Constraint (Mode-Aware, aligned with MobileManipulatorInterface)
;=============================================================================

bodyRelative
{
    activate                   true
    xLowerBound                0.00
    xUpperBound                0.25
    muPosition                 0.5
    muOrientation              1.0
}

;=============================================================================
; Waist Lock (torso joint velocity lock when BodyConstraintMode = LOCKED)
;=============================================================================

waistLock
{
    activate                        true
    numJoints                       4
}

;=============================================================================
; Bimanual Coupling Constraint
;=============================================================================

bimanualCoupling
{
    activate                        true
    
    ; Higher weights to enforce rigid coupling
    muPosition                      5.0
    muOrientation                   5.0
    
    ; Note: Relative pose is captured automatically when switching to COUPLED mode
}

