; OCS2 Wheel Humanoid Configuration - FiveAges W2
; =================================================

;=============================================================================
; Model Information
; 机器人模型的基本结构描述，告诉 OCS2 如何构建 Pinocchio 运动学/动力学模型
;=============================================================================

model_information
{
    ; 机器人底盘类型：
    ;   0 = DefaultManipulator       → 固定基座
    ;   1 = WheelBasedMobileManipulator → 轮式底盘，stateDim = 3(x,y,yaw) + armDim
    manipulatorModelType    0

    ; baseFrame: Pinocchio 模型的根坐标系
    baseFrame               "base_footprint"

    ; eeFrame: 左臂末端执行器坐标系名
    eeFrame                 "left_eef"

    ; eeFrame1: 右臂末端执行器坐标系名
    eeFrame1                "right_eef"

    ; removeJoints: 从 Pinocchio 模型中剔除的关节，不进入 MPC 状态/输入空间
    ; 头部关节已纳入 MPC 规划（用于腰头耦合约束），仅剔除夹爪和底盘转向/驱动轮关节
    removeJoints
    {
        [0]   "rr_steer_joint"
        [1]   "rr_wheel_joint"
        [2]   "rl_steer_joint"
        [3]   "rl_wheel_joint"
        [4]   "fr_steer_joint"
        [5]   "fr_wheel_joint"
        [6]   "fl_steer_joint"
        [7]   "fl_wheel_joint"
        [8]   "left_gripper_joint"
        [9]   "right_gripper_joint"
        [10]  "head_joint1"
        [11]  "head_joint2"
    }
}

;=============================================================================
; Model Settings
;=============================================================================

model_settings
{
    ; usePreComputation: true = 提前缓存 Pinocchio 中间量
    usePreComputation       true

    ; recompileLibraries: true = 每次启动重新生成 CppAD 动态库
    recompileLibraries      true
}

;=============================================================================
; Initial State
; MPC 第一次求解时使用的初始状态向量
; 总维度 = 20（关节：4腰+7左臂+7右臂+2头）
;=============================================================================

initialState
{
    arm
    {
        (0,0)   0.0     ; body_joint1  腰部关节1
        (1,0)   0.0     ; body_joint2  腰部关节2
        (2,0)   0.0     ; body_joint3  腰部关节3
        (3,0)   0.0     ; body_joint4  腰部关节4
        (4,0)   0.0     ; left_joint1  左臂肩关节1
        (5,0)   0.0     ; left_joint2  左臂肩关节2
        (6,0)   0.0     ; left_joint3  左臂肘关节1
        (7,0)   0.0     ; left_joint4  左臂肘关节2
        (8,0)   0.0     ; left_joint5  左臂腕关节1
        (9,0)   0.0     ; left_joint6  左臂腕关节2
        (10,0)  0.0     ; left_joint7  左臂腕关节3
        (11,0)  0.0     ; right_joint1 右臂肩关节1
        (12,0)  0.0     ; right_joint2 右臂肩关节2
        (13,0)  0.0     ; right_joint3 右臂肘关节1
        (14,0)  0.0     ; right_joint4 右臂肘关节2
        (15,0)  0.0     ; right_joint5 右臂腕关节1
        (16,0)  0.0     ; right_joint6 右臂腕关节2
        (17,0)  0.0     ; right_joint7 右臂腕关节3
    }
}

;=============================================================================
; Initial Mode Schedule
;=============================================================================

initialModeSchedule
{
    eventTimes
    {
    }

    ; HM_DUAL_RELATIVE: 固定底盘 + 双臂独立追踪各自目标
    modeSequence
    {
        [0]     HM_DUAL_RELATIVE_FIXED_BASE
    }
}

;=============================================================================
; DDP Settings
;=============================================================================

ddp
{
    algorithm                       SLQ

    nThreads                        3
    threadPriority                  50

    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               false

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

;=============================================================================
; MPC Settings
;=============================================================================

mpc
{
    timeHorizon                     1.0     ; [s]
    solutionTimeWindow              0.2     ; [s]
    coldStart                       false

    debugPrint                      false

    mpcDesiredFrequency             100     ; [Hz]
    mrtDesiredFrequency             400     ; [Hz]
}

;=============================================================================
; Rollout Settings
;=============================================================================

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

;=============================================================================
; Input Cost
; 总输入维度 = 20（关节：4腰+7左臂+7右臂+2头）
;=============================================================================

inputCost
{
    R
    {
        arm
        {
            scaling 1e-3

            (0,0)   1.0     ; body_joint1 速度惩罚
            (1,0)   1.0     ; body_joint2 速度惩罚
            (2,0)   1.0     ; body_joint3 速度惩罚
            (3,0)   1.0     ; body_joint4 速度惩罚
            (4,0)   1.0     ; left_joint1 速度惩罚
            (5,0)   1.0     ; left_joint2 速度惩罚
            (6,0)   1.0     ; left_joint3 速度惩罚
            (7,0)   1.0     ; left_joint4 速度惩罚
            (8,0)   1.0     ; left_joint5 速度惩罚
            (9,0)   1.0     ; left_joint6 速度惩罚
            (10,0)  1.0     ; left_joint7 速度惩罚
            (11,0)  1.0     ; right_joint1 速度惩罚
            (12,0)  1.0     ; right_joint2 速度惩罚
            (13,0)  1.0     ; right_joint3 速度惩罚
            (14,0)  1.0     ; right_joint4 速度惩罚
            (15,0)  1.0     ; right_joint5 速度惩罚
            (16,0)  1.0     ; right_joint6 速度惩罚
            (17,0)  1.0     ; right_joint7 速度惩罚
        }
    }
}

;=============================================================================
; End Effector Constraint
;=============================================================================

endEffector
{
    dualArmMode true
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    dualArmMode true
    muPosition                      20.0
    muOrientation                   10.0
}

;=============================================================================
; Joint Position Limits
;=============================================================================

jointPositionLimits
{
    activate                        true
    mu                              1e-2
    delta                           1e-3
}

;=============================================================================
; Joint Velocity Limits
; 输入布局：[waist(4) | left_arm(7) | right_arm(7) | head(2)]
;=============================================================================

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-3

    lowerBound
    {
        arm
        {
            (0,0)  -0.5         ; body_joint1 [rad/s]
            (1,0)  -0.5         ; body_joint2 [rad/s]
            (2,0)  -0.5         ; body_joint3 [rad/s]
            (3,0)  -0.5         ; body_joint4 [rad/s]
            (4,0)  -1.07        ; left_joint1 [rad/s]
            (5,0)  -1.07        ; left_joint2 [rad/s]
            (6,0)  -1.07        ; left_joint3 [rad/s]
            (7,0)  -1.07        ; left_joint4 [rad/s]
            (8,0)  -1.07        ; left_joint5 [rad/s]
            (9,0)  -1.07        ; left_joint6 [rad/s]
            (10,0) -1.07        ; left_joint7 [rad/s]
            (11,0) -1.07        ; right_joint1 [rad/s]
            (12,0) -1.07        ; right_joint2 [rad/s]
            (13,0) -1.07        ; right_joint3 [rad/s]
            (14,0) -1.07        ; right_joint4 [rad/s]
            (15,0) -1.07        ; right_joint5 [rad/s]
            (16,0) -1.07        ; right_joint6 [rad/s]
            (17,0) -1.07        ; right_joint7 [rad/s]
        }
    }

    upperBound
    {
        arm
        {
            (0,0)  0.5          ; body_joint1 [rad/s]
            (1,0)  0.5          ; body_joint2 [rad/s]
            (2,0)  0.5          ; body_joint3 [rad/s]
            (3,0)  0.5          ; body_joint4 [rad/s]
            (4,0)  1.07         ; left_joint1 [rad/s]
            (5,0)  1.07         ; left_joint2 [rad/s]
            (6,0)  1.07         ; left_joint3 [rad/s]
            (7,0)  1.07         ; left_joint4 [rad/s]
            (8,0)  1.07         ; left_joint5 [rad/s]
            (9,0)  1.07         ; left_joint6 [rad/s]
            (10,0) 1.07         ; left_joint7 [rad/s]
            (11,0) 1.07         ; right_joint1 [rad/s]
            (12,0) 1.07         ; right_joint2 [rad/s]
            (13,0) 1.07         ; right_joint3 [rad/s]
            (14,0) 1.07         ; right_joint4 [rad/s]
            (15,0) 1.07         ; right_joint5 [rad/s]
            (16,0) 1.07         ; right_joint6 [rad/s]
            (17,0) 1.07         ; right_joint7 [rad/s]
        }
    }
}

;=============================================================================
; Self Collision
;=============================================================================

selfCollision
{
    activate                        true

    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01

    collisionObjectPairs
    {
    }

    collisionLinkPairs
    {
        [0] "body_link4, left_link3",
        [1] "body_link4, left_link4",
        [2] "body_link4, left_link5",
        [3] "body_link4, left_link7",
        [4] "body_link4, right_link3",
        [5] "body_link4, right_link4",
        [6] "body_link4, right_link5",
        [7] "body_link4, right_link7",
    }
}
