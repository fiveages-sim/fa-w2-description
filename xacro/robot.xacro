<?xml version="1.0"?>
<robot name="FiveAges W2" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="chassis_joints_movable" default="false"/>
	<xacro:include filename="$(find fiveages_w2_description)/xacro/components/linkhou_s2.xacro"/>
	<xacro:linkhou_s2 joints_movable="$(arg chassis_joints_movable)"/>
	<xacro:include filename="$(find fiveages_w2_description)/xacro/body.xacro"/>


	<!-- Left Arm -->
	<joint name="left_arm_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="left_base_link"/>
		<origin rpy="-${PI/2} 0 0" xyz="0.0 0.062 0"/>
	</joint>

	<!-- Right Arm -->
	<joint name="right_arm_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="right_base_link"/>
		<origin rpy="${PI/2} 0 0" xyz="0 -0.062 0"/>
	</joint>

	<xacro:include filename="$(find fiveages_w2_description)/xacro/components/arm.xacro"/>
	<xacro:M6_CCS name="left" collider="$(arg collider)"/>
	<xacro:M6_CCS name="right" direction="-1" collider="$(arg collider)"/>

	<!-- 从 type 参数解析出 gripper_type -->
	<xacro:arg name="type" default=""/>
	<xacro:property name="type_arg" value="$(arg type)"/>

	<!-- 默认值 -->
	<xacro:property name="selected_gripper_type" value=""/>

	<!-- 从 type 解析 gripper_type -->
	<xacro:if value="${type_arg == 'rg75'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_d'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>


	<xacro:include filename="$(find fiveages_w2_description)/xacro/grippers.xacro"/>
	<xacro:Grippers type="${selected_gripper_type}"/>
</robot>