<?xml version="1.0"?>
<robot name="FiveAges W2" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="chassis_joints_movable" default="false"/>

	<!-- 从 type 参数解析出 hand_type 和 gripper_type -->
	<xacro:arg name="type" default=""/>
	<xacro:property name="type_arg" value="$(arg type)"/>

	<!-- 默认值 -->
	<xacro:property name="selected_hand_type" value=""/>
	<xacro:property name="selected_gripper_type" value=""/>
	<xacro:property name="selected_gripper_pad" value="default"/>

	<!-- 从 type 解析 hand_type 和 gripper_type -->
	<!-- 夹爪类型：selected_gripper_type 不为空即表示使用夹爪 -->
	<xacro:if value="${type_arg == 'rg75'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'rg75_heavy'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
		<xacro:property name="selected_gripper_pad" value="heavy_carry"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_d'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<!-- 灵巧手类型 -->
	<xacro:if value="${type_arg == 'linkerhand_o6'}">
		<xacro:property name="selected_hand_type" value="linkerhand_o6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_l6'}">
		<xacro:property name="selected_hand_type" value="linkerhand_l6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_o7'}">
		<xacro:property name="selected_hand_type" value="linkerhand_o7"/>
	</xacro:if>

	<xacro:include filename="$(find fiveages_w2_description)/xacro/components/linkhou_s2.xacro"/>
	<xacro:linkhou_s2 joints_movable="$(arg chassis_joints_movable)"/>
	<xacro:include filename="$(find fiveages_w2_description)/xacro/components/body.xacro"/>

	<!-- Left Arm -->
	<joint name="left_arm_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="left_base_link"/>
		<origin rpy="-${PI/2} 0 0" xyz="0.0 0.062 0"/>
	</joint>

	<!-- Right Arm -->
	<joint name="right_arm_base_joint" type="fixed">
		<parent link="arm_base"/>
		<child link="right_base_link"/>
		<origin rpy="${PI/2} 0 0" xyz="0 -0.062 0"/>
	</joint>


	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>
	<xacro:M6_CCS name="left" style="fiveages_w2"/>
	<xacro:M6_CCS name="right" direction="-1" style="fiveages_w2"/>

	<xacro:include filename="$(find fiveages_w2_description)/xacro/eefs.xacro"/>
	<xacro:EndEffectors hand_type="${selected_hand_type}" gripper_type="${selected_gripper_type}"/>
</robot>