<?xml version="1.0" ?>
<robot name="FiveAges W2" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:arg name="type" default="arms"/>
	<xacro:arg name="arm_half_spacing" default=""/>
	<xacro:arg name="arm_mount_z" default=""/>

	<xacro:if value="${'$(arg type)' == 'arms'}">
		<link name="arm_base"/>

		<xacro:include filename="$(find m6_ccs_description)/xacro/arm_mount.xacro"/>
		<xacro:set_arm_mount_properties
			arm_half_spacing="$(arg arm_half_spacing)"
			arm_mount_z="$(arg arm_mount_z)"/>
		<xacro:DualArmMountJoints parent="arm_base"/>

		<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>
		<xacro:M6_CCS name="left" style="fiveages_w2"/>
		<xacro:M6_CCS name="right" direction="-1" style="fiveages_w2"/>
	</xacro:if>

</robot>
