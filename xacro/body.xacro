	<joint name="head_camera_joint" type="fixed">
		<origin xyz="-0.097847  0.046703 -0.12364" rpy="0 -0.64460396 ${PI}"/>
		<parent link="head_link2"/>
		<child link="head_camera"/>
	</joint>

	<link name="arm_base"/>
	<joint name="arm_base_joint" type="fixed">
		<origin xyz="7.1612E-05 0 0.45765"/>
		<parent link="body_link4"/>
		<child link="arm_base"/>
