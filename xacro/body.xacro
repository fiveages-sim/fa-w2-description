		<child link="body_link3"/>
		<axis xyz="0 1 0"/>
		<limit lower="-1.745" upper="1.745" effort="100" velocity="1"/>
	</joint>

	<link name="body_link4">
		<inertial>
			<origin xyz="-0.0150844595179076 0.00261332042527829 0.274407850772391"/>
			<mass value="23.7446394325596"/>
			<inertia
					ixx="0.320326293119484"
					ixy="8.41740202015408E-05"
					ixz="0.000603743723020676"
					iyy="0.228575723449718"
