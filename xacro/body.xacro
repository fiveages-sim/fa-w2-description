			</geometry>
		</collision>
	</link>

	<joint name="body_joint1" type="revolute">
		<parent link="body_base"/>
		<child link="body_link1"/>
		<axis xyz="0 1 0"/>
		<limit lower="-1.352633" upper="0.567" effort="100" velocity="1"/>
	</joint>

