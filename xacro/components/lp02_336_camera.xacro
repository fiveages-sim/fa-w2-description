<?xml version="1.0"?>
<robot name="LP02 336 Hand Camera" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="lp02_336_camera" params="prefix parent_link">
        <link name="${prefix}hand_camera_stand">
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w2_description)/meshes/components/lp02_camera.glb"/>
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}hand_camera_stand_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${prefix}hand_camera_stand"/>
        </joint>

        <joint name="${prefix}hand_camera_joint" type="fixed">
            <origin xyz="0.10391 -0.02493 0.029886" rpy="${-PI*11/90} 0 ${PI/2}"/>
            <parent link="${prefix}hand_camera_stand"/>
            <child link="${prefix}hand_camera"/>
        </joint>

        <link name="${prefix}hand_camera">
            <visual>
                <geometry>
                    <mesh filename="file://$(find sensor_models)/meshes/orbbec/336.glb"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>
</robot>
