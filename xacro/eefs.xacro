<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="EndEffectors" params="hand_type:='' gripper_type:=''">

        <!-- Note: 
             - gripper_type 不为空时表示使用夹爪（保持原有逻辑）
             - hand_type 只在需要区分灵巧手时使用（如 linkerhand_o6）
             - 两者都为空时表示无末端执行器配置
        -->

        <!-- 无末端执行器配置 -->
        <xacro:if value="${hand_type == '' and gripper_type == ''}">
            <link name="left_eef"/>
            <link name="right_eef"/>

            <joint name="left_eef_joint" type="fixed">
                <parent link="left_tcp"/>
                <child link="left_eef"/>
            </joint>

            <joint name="right_eef_joint" type="fixed">
                <parent link="right_tcp"/>
                <child link="right_eef"/>
            </joint>
        </xacro:if>

        <!-- 夹爪类型：gripper_type 不为空即表示使用夹爪 -->
        <xacro:if value="${gripper_type == 'ag2f90_c' or gripper_type == 'ag2f90_d'}">
            <xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
            <xacro:AG2F90-C name="left" use_flange="true"/>
            <joint name="left_gripper_fix" type="fixed">
                <parent link="left_tcp"/>
                <child link="left_flange"/>
                <origin xyz="0 0 0.0045"/>
            </joint>

            <xacro:AG2F90-C name="right" use_flange="true"/>
            <joint name="right_gripper_fix" type="fixed">
                <parent link="right_tcp"/>
                <child link="right_flange"/>
                <origin xyz="0 0 0.0045"/>
            </joint>
        </xacro:if>

        <xacro:if value="${gripper_type == 'rg75'}">
            <xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
            <xacro:RG75-300 name="left" use_flange="true" pad="${selected_gripper_pad}"/>
            <xacro:RG75-300 name="right" use_flange="true" pad="${selected_gripper_pad}"/>

            <joint name="left_gripper_base_joint" type="fixed">
                <parent link="left_tcp"/>
                <child link="left_flange"/>
                <xacro:if value="${selected_gripper_pad == 'heavy_carry'}">
                    <origin rpy="0 0 ${PI/2}"/>
                </xacro:if>
            </joint>

            <joint name="right_gripper_base_joint" type="fixed">
                <parent link="right_tcp"/>
                <child link="right_flange"/>
                <xacro:if value="${selected_gripper_pad == 'heavy_carry'}">
                    <origin rpy="0 0 ${PI/2}"/>
                </xacro:if>
            </joint>
        </xacro:if>

        <!-- 灵巧手类型 -->
        <xacro:if value="${hand_type == 'linkerhand_o6'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/o6.xacro"/>
            <xacro:LinkerHandO6 name="left_hand" direction="1" use_flange="true" fixed_joints="false"/>
            <joint name="left_hand_base_joint" type="fixed">
                <origin xyz="0 0 0.0045" rpy="0 0 ${PI}"/>
                <parent link="left_tcp"/>
                <child link="left_hand_flange"/>
            </joint>

            <xacro:LinkerHandO6 name="right_hand" direction="-1" use_flange="true" fixed_joints="false"/>
            <joint name="right_hand_base_joint" type="fixed">
                <parent link="right_tcp"/>
                <child link="right_hand_flange"/>
                <origin xyz="0 0 0.0045"/>
            </joint>
        </xacro:if>

        <xacro:if value="${hand_type == 'linkerhand_o7'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/o7.xacro"/>
            <xacro:LinkerHandO7 name="left_hand" direction="1" use_flange="true" fixed_joints="false"/>
            <joint name="left_hand_base_joint" type="fixed">
                <origin rpy="0 0 ${PI/2}"/>
                <parent link="left_tcp"/>
                <child link="left_hand_flange"/>
            </joint>

            <xacro:LinkerHandO7 name="right_hand" direction="-1" use_flange="true" fixed_joints="false"/>
            <joint name="right_hand_base_joint" type="fixed">
                <origin rpy="0 0 ${-PI/2}"/>
                <parent link="right_tcp"/>
                <child link="right_hand_flange"/>
            </joint>
        </xacro:if>

        <!-- 灵巧手类型 -->
        <xacro:if value="${hand_type == 'linkerhand_l6'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/l6.xacro"/>
            <xacro:LinkerHandL6 name="left_hand" direction="1" use_flange="true" fixed_joints="false"/>
            <joint name="left_hand_base_joint" type="fixed">
                <origin xyz="0 0 0.0045" rpy="0 0 ${PI}"/>
                <parent link="left_tcp"/>
                <child link="left_hand_flange"/>
            </joint>

            <xacro:LinkerHandL6 name="right_hand" direction="-1" use_flange="true" fixed_joints="false"/>
            <joint name="right_hand_base_joint" type="fixed">
                <parent link="right_tcp"/>
                <child link="right_hand_flange"/>
                <origin xyz="0 0 0.0045"/>
            </joint>
        </xacro:if>

    </xacro:macro>
</robot>