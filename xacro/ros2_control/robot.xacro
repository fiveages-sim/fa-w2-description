<?xml version="1.0"?>
<robot name="fiveages_w2" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="arm_ctrl_mode" default="position"/>
	<xacro:arg name="left_ee_drive_type" default=""/>
	<xacro:arg name="right_ee_drive_type" default=""/>

	<xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real' or '$(arg ros2_control_hardware_type)' == 'real_usb'}"/>
	<xacro:property name="ee_drive_type" value="${'usb' if '$(arg ros2_control_hardware_type)' == 'real_usb' else ('marvin' if '$(arg ros2_control_hardware_type)' == 'real' else '')}"/>
	<xacro:property name="left_drive_type" value="${'$(arg left_ee_drive_type)' if '$(arg left_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="right_drive_type" value="${'$(arg right_ee_drive_type)' if '$(arg right_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="arm_ctrl_mode_value" value="$(arg arm_ctrl_mode)"/>
	<xacro:property name="left_ee_type" value="${left_hand_type if left_hand_type != '' else left_gripper_type}"/>
	<xacro:property name="right_ee_type" value="${right_hand_type if right_hand_type != '' else right_gripper_type}"/>

	<xacro:include filename="$(find fiveages_w2_description)/xacro/robot.xacro"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find fiveages_w2_common_description)/xacro/ros2_control/body.xacro"/>
	<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
	<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
	<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
	<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
	<xacro:include filename="$(find freedom_description)/xacro/ros2_control/freedom.xacro"/>
	<xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56E2.xacro"/>

	<xacro:macro name="side_gripper_joint" params="side">
		<joint name="${side}_gripper_joint">
			<command_interface name="position"/>
			<state_interface name="position">
				<param name="initial_value">0</param>
			</state_interface>
		</joint>
	</xacro:macro>

	<xacro:macro name="side_rg75_interfaces" params="side">
		<xacro:rg75_interfaces name="${side}"/>
	</xacro:macro>

	<xacro:macro name="side_ag2f90_interfaces" params="side">
		<xacro:ag2f90c_interfaces name="${side}"/>
	</xacro:macro>

	<xacro:macro name="side_hand_interfaces" params="side hand_type">
		<xacro:if value="${hand_type in ['linkerhand_o6', 'linkerhand_l6']}">
			<xacro:linkerhand_o6_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'linkerhand_o7'}">
			<xacro:linkerhand_o7_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'freedom_v1'}">
			<xacro:freedom_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'inspire_e2'}">
			<xacro:inspire_rh56e2_interfaces name="${side}_hand"/>
		</xacro:if>
	</xacro:macro>

	<xacro:macro name="side_usb_hand_system" params="side hand_type serial_port">
		<xacro:property name="usb_hand_system_name" value="${str('linkerhand_7' if hand_type == 'linkerhand_o7' else ('inspire_e2' if hand_type == 'inspire_e2' else 'linkerhand_6'))}"/>
		<ros2_control name="${usb_hand_system_name}_${side}_system" type="system">
			<hardware>
				<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="hand_type">${hand_type}</param>
				<param name="hand_side">${side}</param>
				<param name="max_speed_ratio">1.0</param>
			</hardware>
			<xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
		</ros2_control>
	</xacro:macro>

	<xacro:macro name="side_freedom_usb_hand_system" params="side serial_port">
		<ros2_control name="freedom_v1_${side}_system" type="system">
			<hardware>
				<plugin>modbus_ros2_control/FreedomRS485Hardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="hand_side">${side}</param>
				<param name="slave_id">auto</param>
				<param name="baudrate">115200</param>
				<param name="read_feedback">true</param>
				<param name="feedback_timeout_ms">20</param>
			</hardware>
			<xacro:freedom_interfaces name="${side}_hand"/>
		</ros2_control>
	</xacro:macro>

	<xacro:macro name="side_freedom_usb_can_hand_system" params="side can_interface device_id">
		<ros2_control name="freedom_v1_${side}_can_system" type="system">
			<hardware>
				<plugin>can_ros2_control/FreedomCanHardware</plugin>
				<param name="can_interface">${can_interface}</param>
				<param name="device_id">${device_id}</param>
				<param name="read_feedback">true</param>
				<param name="feedback_timeout_ms">1</param>
			</hardware>
			<xacro:freedom_interfaces name="${side}_hand"/>
		</ros2_control>
	</xacro:macro>

	<xacro:if value="${is_real_hardware}">
		<ros2_control name="M6_CCS_System" type="system">
			<hardware>
				<plugin>marvin_ros2_control/MarvinHardware</plugin>
				<param name="arm_type">dual</param>
				<param name="ctrl_mode">${arm_ctrl_mode_value}</param>
				<xacro:if value="${(left_drive_type == 'marvin' or left_drive_type == 'tianji_can') and left_ee_type != ''}">
					<param name="left_ee_type">${left_ee_type}</param>
					<xacro:if value="${left_drive_type == 'tianji_can'}">
						<param name="left_ee_channel">1</param>
					</xacro:if>
				</xacro:if>
				<xacro:if value="${(right_drive_type == 'marvin' or right_drive_type == 'tianji_can') and right_ee_type != ''}">
					<param name="right_ee_type">${right_ee_type}</param>
					<xacro:if value="${right_drive_type == 'tianji_can'}">
						<param name="right_ee_channel">1</param>
					</xacro:if>
				</xacro:if>
				<param name="max_joint_speed">50</param>
				<param name="max_joint_acceleration">30</param>
				<param name="left_dyn_param">0.4,0,0,50.65,0,0,0,0,0,0</param>
				<param name="right_dyn_param">0.4,0,0,50.85,0,0,0,0,0,0</param>
				<param name="device_ip">192.168.1.190</param>
			</hardware>

			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>

			<xacro:if value="${left_gripper_type != ''}">
				<xacro:side_gripper_joint side="left"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type != ''}">
				<xacro:side_gripper_joint side="right"/>
			</xacro:if>

			<xacro:if value="${left_drive_type == 'marvin' or right_drive_type == 'marvin' or left_drive_type == 'tianji_can' or right_drive_type == 'tianji_can'}">
				<xacro:if value="${(left_drive_type == 'marvin' or left_drive_type == 'tianji_can') and left_hand_type != ''}">
					<xacro:side_hand_interfaces side="left" hand_type="${left_hand_type}"/>
				</xacro:if>
				<xacro:if value="${(right_drive_type == 'marvin' or right_drive_type == 'tianji_can') and right_hand_type != ''}">
					<xacro:side_hand_interfaces side="right" hand_type="${right_hand_type}"/>
				</xacro:if>
			</xacro:if>
		</ros2_control>

		<ros2_control name="juxie_body" type="system">
			<hardware>
				<plugin>juxie_ros2_control/JxHardware</plugin>
				<param name="can_interface">can0</param>
				<param name="motor_ids">1,2,3,4,5,6</param>
				<param name="control_period_ms">1</param>
			</hardware>
			<xacro:body_interfaces/>
		</ros2_control>

		<xacro:if value="${left_drive_type == 'usb' or right_drive_type == 'usb' or left_drive_type == 'usb_can' or right_drive_type == 'usb_can'}">
			<xacro:if value="${left_drive_type == 'usb' and left_hand_type in ('linkerhand_o6', 'linkerhand_l6', 'linkerhand_o7', 'inspire_e2')}">
				<xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="/dev/ttyUSB0"/>
			</xacro:if>
			<xacro:if value="${right_drive_type == 'usb' and right_hand_type in ('linkerhand_o6', 'linkerhand_l6', 'linkerhand_o7', 'inspire_e2')}">
				<xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="/dev/ttyUSB2"/>
			</xacro:if>
			<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v1'}">
				<xacro:side_freedom_usb_hand_system side="left" serial_port="/dev/ttyUSB0"/>
			</xacro:if>
			<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v1'}">
				<xacro:side_freedom_usb_hand_system side="right" serial_port="/dev/ttyUSB2"/>
			</xacro:if>
			<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'freedom_v1'}">
				<xacro:side_freedom_usb_can_hand_system side="left" can_interface="can0" device_id="0"/>
			</xacro:if>
			<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'freedom_v1'}">
				<xacro:side_freedom_usb_can_hand_system side="right" can_interface="can1" device_id="1"/>
			</xacro:if>
		</xacro:if>
	</xacro:if>

	<xacro:unless value="${is_real_hardware}">
		<ros2_control name="fiveages_w2_system" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
					<param name="sum_wrapped_joint_states">false</param>
					<param name="initialize_commands_from_state">true</param>
				</xacro:if>
			</hardware>

			<xacro:body_interfaces/>
			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>

			<xacro:if value="${left_gripper_type == 'rg75'}">
				<xacro:side_rg75_interfaces side="left"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type == 'rg75'}">
				<xacro:side_rg75_interfaces side="right"/>
			</xacro:if>

			<xacro:if value="${left_gripper_type in ('ag2f90_c', 'ag2f90_d')}">
				<xacro:side_ag2f90_interfaces side="left"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type in ('ag2f90_c', 'ag2f90_d')}">
				<xacro:side_ag2f90_interfaces side="right"/>
			</xacro:if>

			<xacro:if value="${left_hand_type != ''}">
				<xacro:side_hand_interfaces side="left" hand_type="${left_hand_type}"/>
			</xacro:if>
			<xacro:if value="${right_hand_type != ''}">
				<xacro:side_hand_interfaces side="right" hand_type="${right_hand_type}"/>
			</xacro:if>
		</ros2_control>
	</xacro:unless>

	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<xacro:property name="ros2_control_config_basename" value="ros2_controllers.yaml"/>
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find fiveages_w2_description)/config/ros2_control/common.yaml</parameters>
				<parameters>$(find fiveages_w2_description)/config/ros2_control/${ros2_control_config_basename}</parameters>
			</plugin>
		</gazebo>
	</xacro:if>

</robot>
