<?xml version="1.0"?>
<robot name="fiveages_w2" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="device_ip" default="192.168.1.190"/>
	<xacro:property name="device_ip_arg" value="$(arg device_ip)"/>
	<xacro:property name="ros2_control_hardware_type_arg" value="$(arg ros2_control_hardware_type)"/>

	<xacro:include filename="$(find fiveages_w2_description)/xacro/robot.xacro"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find fiveages_w2_description)/xacro/ros2_control/body.xacro"/>

	<!-- quick_start.sh uses hardware:=real (485/marvin) and hardware:=real_usb (USB/modbus hand).
	     Treat both as "real" branches, but force USB hand mode when hardware==real_usb. -->
	<xacro:if value="${ros2_control_hardware_type_arg == 'real_usb'}">
		<xacro:property name="hand_control_mode_arg" value="usb"/>
	</xacro:if>

	<xacro:if value="${ros2_control_hardware_type_arg == 'real' or ros2_control_hardware_type_arg == 'real_usb'}">
		<!-- 确定传递给 marvin_ros2_control 的 gripper_type 参数 -->
		<!-- 
			Marvin 模式下的手部控制逻辑：
			1. 如果 hand_control_mode_arg == 'marvin'（由 type 后缀 _marvin 设定）且 selected_hand_type 不为空，
			   则将 selected_hand_type (如 linkerhand_o7) 传递给 MarvinHardware 的 gripper_type 参数
			2. MarvinHardware 会通过 normalizeString() 将 gripper_type 转换为大写
			3. 在 createTool() 和 contains_gripper() 中检测 gripper_type 是否包含 "LINKERHAND" 或 "HAND"
			4. 如果检测到手部类型，MarvinHardware 会创建对应的 DexterousHand 对象（O7/O6/L6）
			5. 手的控制通过 485 总线完成，不需要独立的 modbus_ros2_control 系统
		-->
		<xacro:property name="marvin_gripper_type" value="${selected_gripper_type}"/>
		<xacro:if value="${selected_hand_type != '' and hand_control_mode_arg == 'marvin'}">
			<!-- marvin 模式下，将手部类型传递给 gripper_type，让 MarvinHardware 检测并创建手部对象 -->
			<xacro:property name="marvin_gripper_type" value="${selected_hand_type}"/>
		</xacro:if>
		
		<ros2_control name="M6_CCS_System" type="system">
			<hardware>
				<plugin>marvin_ros2_control/MarvinHardware</plugin>
				<param name="arm_type">dual</param>
				<param name="ctrl_mode">position</param>
				<!-- 
					gripper_type 参数说明：
					- 如果是夹爪：传递夹爪类型（如 rg75, ag2f90_c 等）
					- 如果是 marvin 模式的手部：传递手部类型（如 linkerhand_o7, linkerhand_o6, linkerhand_l6）
					- MarvinHardware 会自动检测 gripper_type 中是否包含 "LINKERHAND" 或 "HAND" 来判断是手部还是夹爪
				-->
				<param name="gripper_type">${marvin_gripper_type}</param>
				<param name="max_joint_speed">50</param>
				<param name="max_joint_acceleration">30</param>
				<!-- <param name="ctrl_mode">JOINT_IMPEDANCE</param> -->
				<param name="left_dyn_param">0.4,0,0,50.65,0,0,0,0,0,0</param>
				<param name="right_dyn_param">0.4,0,0,50.85,0,0,0,0,0,0</param>
				<param name="device_ip">${device_ip_arg}</param>
			</hardware>

			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>

			<!-- 夹爪接口：selected_gripper_type 不为空即表示使用夹爪 -->
			<xacro:if value="${selected_gripper_type != ''}">
				<joint name="left_gripper_joint">
					<command_interface name="position"/>
					<state_interface name="position">
						<param name="initial_value">0</param>
					</state_interface>
				</joint>
				<joint name="right_gripper_joint">
					<command_interface name="position"/>
					<state_interface name="position">
						<param name="initial_value">0</param>
					</state_interface>
				</joint>
			</xacro:if>
			<!-- 灵巧手接口：marvin 模式（485 总线，通过 M6_CCS_System） -->
			<xacro:if value="${selected_hand_type != '' and hand_control_mode_arg == 'marvin'}">
				<xacro:if value="${selected_hand_type == 'linkerhand_o6' or selected_hand_type == 'linkerhand_l6'}">
					<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
					<xacro:linkerhand_o6_interfaces name="left_hand"/>
					<xacro:linkerhand_o6_interfaces name="right_hand"/>
				</xacro:if>
				<xacro:if value="${selected_hand_type == 'linkerhand_o7'}">
					<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
					<xacro:linkerhand_o7_interfaces name="left_hand"/>
					<xacro:linkerhand_o7_interfaces name="right_hand"/>
				</xacro:if>
			</xacro:if>
		
		</ros2_control>

		<ros2_control name="juxie_body" type="system">
			<hardware>
				<plugin>juxie_ros2_control/JxHardware</plugin>
				<!-- CAN 接口配置 -->
				<param name="can_interface">can0</param>
				<!-- 电机 ID 列表（最多 8 个） -->
				<param name="motor_ids">1,2,3,4,5,6</param>
				<!-- 控制周期（毫秒） -->
				<param name="control_period_ms">1</param>
			</hardware>

			<xacro:body_interfaces/>
		</ros2_control>

		<!-- 灵巧手接口：USB 模式（modbus_ros2_control），直接内联 ros2_control 配置 -->
		<xacro:if value="${selected_hand_type != '' and hand_control_mode_arg == 'usb'}">
			<!-- O6/L6: 6-DOF 手 -->
			<xacro:if value="${selected_hand_type == 'linkerhand_o6' or selected_hand_type == 'linkerhand_l6'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
				<ros2_control name="linkerhand_6_left_system" type="system">
					<hardware>
						<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
						<param name="serial_port">/dev/ttyUSB1</param>
						<param name="hand_type">${selected_hand_type}</param>
						<param name="hand_side">left</param>
						<param name="max_speed_ratio">1.0</param>
					</hardware>
					<xacro:linkerhand_o6_interfaces name="left_hand"/>
				</ros2_control>
				<ros2_control name="linkerhand_6_right_system" type="system">
					<hardware>
						<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
						<param name="serial_port">/dev/ttyUSB0</param>
						<param name="hand_type">${selected_hand_type}</param>
						<param name="hand_side">right</param>
						<param name="max_speed_ratio">1.0</param>
					</hardware>
					<xacro:linkerhand_o6_interfaces name="right_hand"/>
				</ros2_control>
			</xacro:if>
			<!-- O7: 7-DOF 手 -->
			<xacro:if value="${selected_hand_type == 'linkerhand_o7'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
				<ros2_control name="linkerhand_7_left_system" type="system">
					<hardware>
						<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
						<param name="serial_port">/dev/ttyUSB1</param>
						<param name="hand_type">${selected_hand_type}</param>
						<param name="hand_side">left</param>
						<param name="max_speed_ratio">1.0</param>
					</hardware>
					<xacro:linkerhand_o7_interfaces name="left_hand"/>
				</ros2_control>
				<ros2_control name="linkerhand_7_right_system" type="system">
					<hardware>
						<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
						<param name="serial_port">/dev/ttyUSB0</param>
						<param name="hand_type">${selected_hand_type}</param>
						<param name="hand_side">right</param>
						<param name="max_speed_ratio">1.0</param>
					</hardware>
					<xacro:linkerhand_o7_interfaces name="right_hand"/>
				</ros2_control>
			</xacro:if>
		</xacro:if>
	</xacro:if>


	<xacro:unless value="${ros2_control_hardware_type_arg == 'real' or ros2_control_hardware_type_arg == 'real_usb'}">
		<ros2_control name="fiveages_w2_system" type="system">
			<hardware>
				<xacro:if value="${ros2_control_hardware_type_arg == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${ros2_control_hardware_type_arg == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${ros2_control_hardware_type_arg == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
					<param name="sum_wrapped_joint_states">false</param>
					<param name="initialize_commands_from_state">true</param>
				</xacro:if>
			</hardware>

			<xacro:body_interfaces/>
			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>

			<!-- 夹爪接口：selected_gripper_type 不为空即表示使用夹爪 -->
			<xacro:if value="${selected_gripper_type == 'rg75'}">
				<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
				<xacro:rg75_interfaces name="left"/>
				<xacro:rg75_interfaces name="right"/>
			</xacro:if>

			<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
				<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
				<xacro:ag2f90c_interfaces name="left"/>
				<xacro:ag2f90c_interfaces name="right"/>
			</xacro:if>

			<!-- 灵巧手接口 -->
			<xacro:if value="${selected_hand_type == 'linkerhand_o6' or selected_hand_type == 'linkerhand_l6'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
				<xacro:linkerhand_o6_interfaces name="left_hand"/>
				<xacro:linkerhand_o6_interfaces name="right_hand"/>
			</xacro:if>
			<xacro:if value="${selected_hand_type == 'linkerhand_o7'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
				<xacro:linkerhand_o7_interfaces name="left_hand"/>
				<xacro:linkerhand_o7_interfaces name="right_hand"/>
			</xacro:if>

		</ros2_control>
	</xacro:unless>

	<!-- Gazebo plugin configuration -->
	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<xacro:property name="ros2_control_config_basename" value="ros2_controllers.yaml"/>

		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find fiveages_w2_description)/config/ros2_control/${ros2_control_config_basename}
				</parameters>
			</plugin>
		</gazebo>
	</xacro:if>


</robot>
